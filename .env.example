DEBUG=True
SECRET_KEY=your_secret_key_here
PORT=8001
API_PREFIX=/api/v1

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
CHAT_HISTORY_LIMIT=30

MONGO_URL=mongodb://localhost:27017
MONGO_DB=sgk_toan

REDIS_URL=redis://localhost:6379
ENABLE_RATE_LIMIT=True

LOG_LEVEL=INFO
# Set true only when debugging HTTP requests (otherwise OCR polling fills the console).
UVICORN_ACCESS_LOG=false

# --- SGK PDF Processing ---
STORAGE_PATH=./storage
GEMINI_API_KEY=gemini_api_key_from_spring_boot
GEMINI_MODEL=gemini-2.5-flash
MATHPIX_APP_ID=mathpix_app_id_from_spring_boot
MATHPIX_APP_KEY=mathpix_app_key_from_spring_boot
MATHPIX_ENABLED=false
MAX_FILE_SIZE_MB=50
# Keep raw OCR page images at storage/books/<bookId>/pages (recommended for verify preview)
KEEP_PAGE_IMAGES=true

# MinIO — same endpoint/credentials/bucket as Spring Boot (book PDFs → template bucket)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_TEMPLATE_BUCKET=slide-templates
# Keep aligned with Spring MINIO_OCR_CONTENT_BUCKET when moving image assets to private object keys
MINIO_OCR_CONTENT_BUCKET=slide-templates